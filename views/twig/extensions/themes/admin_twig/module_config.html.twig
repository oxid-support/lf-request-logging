{% extends "module_config.html.twig" %}

{% block admin_module_config_form %}
    {% if oView.getEditObjectId() == 'oxsheartbeat' %}
    <div style="margin-bottom: 20px; padding: 15px; background: #e3f2fd; border: 1px solid #2196f3; border-radius: 4px;">
        <p style="margin: 0;">
            {{ translate({ ident: "OXSHEARTBEAT_MODULE_CONFIG_HINT" }) }}
            <a href="{{ oViewConf.getSelfLink()|replace({"&amp;": "&"})|raw }}&cl=heartbeat_apiuser_setup" style="font-weight: bold;">{{ translate({ ident: "OXSHEARTBEAT_MODULE_CONFIG_HINT_LINK" }) }}</a>.
        </p>
    </div>
    {% endif %}

    {{ parent() }}
{% endblock %}
